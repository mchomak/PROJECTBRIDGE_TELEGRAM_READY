{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!src/shared/api/generated", "!dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
