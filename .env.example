# Placeholders for local development. Replace angle-bracket values when
# Stage 01 adds the applications and their environment configuration.
DJANGO_SECRET_KEY=<local-secret-key>
DJANGO_DEBUG=<true-or-false>
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
REDIS_URL=redis://<host>:<port>/<database>
ALLOWED_HOSTS=<comma-separated-hosts>
CSRF_TRUSTED_ORIGINS=<comma-separated-origins>
FRONTEND_BASE_URL=<frontend-origin>
FILE_STORAGE_ROOT=<local-upload-path>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
AI_PROVIDER=<provider-name>
AI_PROVIDER_API_KEY=<provider-api-key>
AI_MODEL=<model-id>
