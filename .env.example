# Local Compose inputs only. Replace placeholders for your machine if needed.
# These development-only values are not production secrets.
DJANGO_SECRET_KEY=projectbridge-local-insecure-secret-for-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_HOST_PORT=8000

DB_NAME=projectbridge
DB_USER=projectbridge
DB_PASSWORD=projectbridge-local-db-password
REDIS_PASSWORD=projectbridge-local-redis-password

# Optional; provider calls remain unavailable when unset.
OPENAI_API_KEY=
